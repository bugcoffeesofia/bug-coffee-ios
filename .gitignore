# Signing material — never commit private keys or certs
Scripts/certs/
*.p12
*.pem
*.cer

# Signed output
*.pkpass

# Xcode
DerivedData/
build/
*.xcuserstate
xcuserdata/
.DS_Store
# The Xcode project is generated by XcodeGen (project.yml); only its Swift
# package lock file is committed, because Xcode Cloud requires it.
*.xcodeproj/*
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcodeproj/project.xcworkspace/xcshareddata/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
